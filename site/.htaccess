RewriteEngine on

# Country geofence. Env var is set by mod_maxminddb
# (see /etc/httpd/conf.d/z-geofence.conf). Harmless no-op if the module is off.
# AR BD BR CN CO HK ID IN IQ MA PH PK RU SG VE VN
# Skip ErrorDocument subrequests or [F] on 403.html loops until 500.
<IfModule mod_maxminddb.c>
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/(400|401|403|404|500)\.html$
RewriteCond %{ENV:MM_COUNTRY_CODE} ^(AR|BD|BR|CN|CO|HK|ID|IN|IQ|MA|PH|PK|RU|SG|VE|VN)$
RewriteRule ^ - [F,L]
</IfModule>

# Google crawler range currently hammering the expensive ranking reports.
# Keep the rest of the site available to Google and block only rank renderers.
RewriteCond %{REMOTE_ADDR} ^66\.249\.
RewriteRule ^(?:Rank(?:Day|Month|Year|Periods|Spells)|rank(?:day|month|year|periods|spells)data)\.php$ - [F,L,NC]

# Azure / Microsoft cloud on expensive ranking reports only (2026-08-06).
# Same scope as the Googlebot rule above. UK weather site - almost no
# legitimate RankPeriods browsers come from Azure VMs; scrapers do.
# Covers MSFT space seen in siteV5Access: 13/20/40/52/104.40-47/168.61-63/172.160-191.
RewriteCond %{REMOTE_ADDR} ^(?:13|20|40|52)\.
RewriteRule ^(?:Rank(?:Day|Month|Year|Periods|Spells)|rank(?:day|month|year|periods|spells)data)\.php$ - [F,L,NC]
RewriteCond %{REMOTE_ADDR} ^104\.4[0-7]\.
RewriteRule ^(?:Rank(?:Day|Month|Year|Periods|Spells)|rank(?:day|month|year|periods|spells)data)\.php$ - [F,L,NC]
RewriteCond %{REMOTE_ADDR} ^168\.6[1-3]\.
RewriteRule ^(?:Rank(?:Day|Month|Year|Periods|Spells)|rank(?:day|month|year|periods|spells)data)\.php$ - [F,L,NC]
RewriteCond %{REMOTE_ADDR} ^172\.1(?:6[0-9]|7[0-9]|8[0-9]|9[01])\.
RewriteRule ^(?:Rank(?:Day|Month|Year|Periods|Spells)|rank(?:day|month|year|periods|spells)data)\.php$ - [F,L,NC]

# Meta / Facebook cloud on expensive ranking reports only (2026-08-08).
# Same scope as Azure/Googlebot. Scrapers on 57.141.20/24 (AS32934) have been
# combinatorially harvesting RankPeriods; also cover common FB crawl prefixes.
RewriteCond %{REMOTE_ADDR} ^57\.141\.
RewriteRule ^(?:Rank(?:Day|Month|Year|Periods|Spells)|rank(?:day|month|year|periods|spells)data)\.php$ - [F,L,NC]
RewriteCond %{REMOTE_ADDR} ^(?:31\.13|66\.220|69\.63|69\.171|157\.240|173\.252|179\.60|185\.60)\.
RewriteRule ^(?:Rank(?:Day|Month|Year|Periods|Spells)|rank(?:day|month|year|periods|spells)data)\.php$ - [F,L,NC]

# Runtime caches contain PHP serializations and generated PHP tag files. They
# are server-side inputs only and must never be served directly.
RewriteRule ^cache(?:/|$) - [F,L]

# Preserve established public URLs while generated assets live outside root.
RewriteRule ^(skycam(?:_home|_wx2|_wx2_sunset)?\.jpg)$ generated/v5/$1 [L]
RewriteRule ^(skycam_(?:small|sunset|small_small)\.jpg)$ generated/legacy/$1 [L]
RewriteRule ^((?:stitchedmaingraph(?:_small)?|mainGraph[1-4]|rose_(?:24hrs|month|year|all))\.png)$ generated/legacy/$1 [L]
RewriteRule ^((?:dailywebcam|todaywebcam)\.jpg)$ generated/legacy/$1 [L]

# Block fake Chrome versions
#RewriteCond %{HTTP_USER_AGENT} "Chrome/[0-9]+\.0\.0\.0" [NC]
#RewriteRule .* - [F,L]
SetEnvIfNoCase User-Agent "Chrome/133\.0\.0\.0" bad_bot

<FilesMatch "^(400|401|403|404|500)\.html$">
RewriteEngine Off
order allow,deny
allow from all
require all granted
</FilesMatch>

deny from env=bad_bot
