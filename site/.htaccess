# Block semalt
RewriteCond %{HTTP_REFERER} .*semalt\.com [NC]
RewriteRule .* - [F]

RewriteCond %{HTTP_HOST} ^www\.nw3weather\.co\.uk [NC]
RewriteRule ^(.*)$ https://nw3weather.co.uk/$1 [L,R=301]

redirect 301 /wx.php /
redirect 301 /dailyreport.htm /dailyreport.php
redirect 301 /wxaverages.htm /wxaverages.php
redirect 301 /wxtempltas.html /wxtempltas.php
redirect 301 /contact.html /contact.php
redirect 301 /curr24hourgraph.gif /stitchedmaingraph_small.png
redirect 301 /jpgwebcam.jpg /currcam.jpg

redirect 301 /Historical.php /oldSites/sitev2/Historical.php
redirect 301 /sitemap.php /
redirect 301 /sitev3 /
redirect 301 /wx100.php /wx10.php?humtype=dew

# v5 hard-cutover compatibility: retired public pages
redirect 301 /wx4.php /RankDay.php
redirect 301 /wxdatadaySimple.php /wxdataday.php
redirect 301 /wxhistmonthB.php /wxhistmonth.php
redirect 301 /grapharchive.php /graphviewer.php
redirect 301 /chartviewer.php /graphviewer.php
redirect 301 /graph12.php /graphviewer.php
redirect 301 /graph31.php /graphviewer.php
redirect 301 /graph_annual.php /graphviewer.php
redirect 301 /graph_daily_trend.php /graphviewer.php
redirect 301 /graphday.php /oldSites/sitev3/graphday.php
redirect 301 /graphday2.php /oldSites/sitev3/graphday2.php
redirect 301 /graphdayA.php /oldSites/sitev3/graphdayA.php
redirect 301 /graphclim.php /oldSites/sitev3/graphclim.php
redirect 301 /graphclim365.php /wxtempltas.php#graph
redirect 301 /windrose.php /windrose_viewer.php
redirect 301 /wcarchive.php /wx2.php

RewriteCond %{HTTP_HOST} ^.*$
RewriteRule ^Beaufort\ Scale.html$ /BeaufortScale.php [R=301,L]
RewriteRule ^Beaufort\ Scale.php$ /BeaufortScale.php [R=301,L]
RewriteRule ^(wx[0-9]+).html$ "/$1\.php" [R=301,L]
RewriteRule ^album[0-9]+m?.php$ /wx7.php [R=301,L]
RewriteRule ^wxhist[0-9\.]+.php$ /wxdataday.php [R=301,L]
RewriteRule ^wxsumhist[0-9\.]+.php$ /TablesDataMonth.php [R=301,L]
RewriteRule ^IMG_0417e?.JPG$ /photos/IMG_0417.JPG [R=301,L]

RewriteCond %{HTTP_HOST} ^nw3weather\.co\.uk$ [OR]
RewriteCond %{HTTP_HOST} ^www\.nw3weather\.co\.uk$
RewriteRule ^index\.php$ "https\:\/\/nw3weather\.co\.uk\/" [R=301,L]
